# Copie para .env (gitignored) e ajuste.

# Chave da OpenAI: direto aqui...
# OPENAI_API_KEY=sk-...
# ...ou o caminho de um .env que já tenha OPENAI_API_KEY (só essa variável é lida dele).
OPENAI_ENV_FILE=/caminho/para/outro-projeto/.env

OPENAI_MODEL=gpt-5.5
# minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
