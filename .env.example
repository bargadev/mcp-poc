# Copy to .env (gitignored) and adjust.

# OpenAI key: either set it here...
# OPENAI_API_KEY=sk-...
# ...or point to a .env that already has OPENAI_API_KEY (only that variable is read from it).
OPENAI_ENV_FILE=/path/to/other-project/.env

OPENAI_MODEL=gpt-5.5
# minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
